<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CLASSIFIED FILE</title>

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  min-height:100vh;
  background:#050505;
  color:white;
  font-family:Arial, sans-serif;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}

.screen{
  width:100%;
  max-width:700px;
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:30px;
}

.box{
  width:100%;
  padding:40px 25px;
  border:1px solid #333;
  background:linear-gradient(145deg,#111,#050505);
  box-shadow:0 0 50px rgba(255,200,0,.08);
}

/* BATMAN LOGO */
.logo{
  width:250px;
  height:115px;
  margin:0 auto 35px;
  display:flex;
  align-items:center;
  justify-content:center;
  filter:drop-shadow(0 0 18px rgba(245,196,0,.3));
}

.logo svg{
  width:100%;
  height:100%;
}

.small{
  color:#888;
  letter-spacing:3px;
  font-size:13px;
  margin-bottom:20px;
}

#status{
  font-family:monospace;
  color:#f5c400;
  font-size:18px;
  margin:15px 0;
}

.progress{
  width:100%;
  height:5px;
  background:#222;
  margin:25px 0;
  overflow:hidden;
}

.bar{
  width:0%;
  height:100%;
  background:#f5c400;
  transition:width .1s linear;
}

#percent{
  color:#aaa;
  font-family:monospace;
  font-size:13px;
}

h1{
  font-size:32px;
  letter-spacing:4px;
  margin:20px 0;
}

p{
  color:#bbb;
  line-height:1.9;
  font-size:17px;
}

button{
  margin-top:25px;
  padding:14px 30px;
  border:1px solid #f5c400;
  background:#f5c400;
  color:#050505;
  font-weight:bold;
  font-size:15px;
  cursor:pointer;
  letter-spacing:1px;
}

button:hover{
  background:#fff;
}

#message{
  display:none;
}

.message{
  font-size:22px;
  line-height:2;
  color:#fff;
}

.heart{
  color:#f5c400;
  font-size:30px;
}

.fade{
  animation:fade .8s ease;
}

@keyframes fade{
  from{
    opacity:0;
    transform:translateY(10px)
  }
  to{
    opacity:1;
    transform:translateY(0)
  }
}
</style>
</head>

<body>

<div class="screen">

  <!-- INTRO -->
  <div class="box" id="intro">

    <div class="logo">

      <svg viewBox="0 0 320 196" xmlns="http://www.w3.org/2000/svg">

        <!-- Yellow oval -->
        <ellipse
          cx="160"
          cy="98"
          rx="150"
          ry="78"
          fill="#f5c400"
          stroke="#000"
          stroke-width="5"
        />

        <!-- Batman -->
        <g fill="#050505">

          <path d="
          M160 42
          L150 42
          L142 30
          C144 72 111 70 84 43
          C25 76 23 101 70 142
          C48 121 78 105 108 136
          C116 119 142 120 159 162
          L160 42
          Z"/>

          <path d="
          M160 42
          L170 42
          L178 30
          C176 72 209 70 236 43
          C295 76 297 101 250 142
          C272 121 242 105 212 136
          C204 119 178 120 161 162
          L160 42
          Z"/>

        </g>

      </svg>

    </div>

    <div class="small">WAYNE SYSTEMS // CLASSIFIED</div>

    <div id="status">ACCESSING CLASSIFIED FILE...</div>

    <div class="progress">
      <div class="bar" id="bar"></div>
    </div>

    <div id="percent">0%</div>

  </div>


  <!-- WELCOME -->
  <div class="box" id="welcome" style="display:none;">

    <div class="logo">

      <svg viewBox="0 0 320 196" xmlns="http://www.w3.org/2000/svg">

        <ellipse
          cx="160"
          cy="98"
          rx="150"
          ry="78"
          fill="#f5c400"
          stroke="#000"
          stroke-width="5"
        />

        <g fill="#050505">

          <path d="
          M160 42
          L150 42
          L142 30
          C144 72 111 70 84 43
          C25 76 23 101 70 142
          C48 121 78 105 108 136
          C116 119 142 120 159 162
          L160 42
          Z"/>

          <path d="
          M160 42
          L170 42
          L178 30
          C176 72 209 70 236 43
          C295 76 297 101 250 142
          C272 121 242 105 212 136
          C204 119 178 120 161 162
          L160 42
          Z"/>

        </g>

      </svg>

    </div>

    <div class="small">IDENTITY VERIFIED ✓</div>

    <h1>WELCOME, ARSANY.</h1>

    <p>
      You've been granted access to one very important file.
    </p>

    <button onclick="openFile()">OPEN FILE →</button>

  </div>


  <!-- MESSAGE -->
  <div class="box" id="message">

    <div class="logo">

      <svg viewBox="0 0 320 196" xmlns="http://www.w3.org/2000/svg">

        <ellipse
          cx="160"
          cy="98"
          rx="150"
          ry="78"
          fill="#f5c400"
          stroke="#000"
          stroke-width="5"
        />

        <g fill="#050505">

          <path d="
          M160 42
          L150 42
          L142 30
          C144 72 111 70 84 43
          C25 76 23 101 70 142
          C48 121 78 105 108 136
          C116 119 142 120 159 162
          L160 42
          Z"/>

          <path d="
          M160 42
          L170 42
          L178 30
          C176 72 209 70 236 43
          C295 76 297 101 250 142
          C272 121 242 105 212 136
          C204 119 178 120 161 162
          L160 42
          Z"/>

        </g>

      </svg>

    </div>

    <div class="small">CLASSIFIED MESSAGE</div>

    <div class="message">
      كل سنة و أنت طيب و بألف خير يا هندسة،<br>
      تنعاد عليك السنين و أنت محقق كل اللي بتتمناه
      <div class="heart">🫡 ♥</div>
    </div>

  </div>

</div>


<script>

let progress = 0;

let timer = setInterval(function(){

  progress++;

  document.getElementById("bar").style.width = progress + "%";
  document.getElementById("percent").innerText = progress + "%";

  if(progress >= 100){

    clearInterval(timer);

    setTimeout(function(){

      document.getElementById("intro").style.display = "none";
      document.getElementById("welcome").style.display = "block";
      document.getElementById("welcome").classList.add("fade");

    },700);

  }

},35);


function openFile(){

  document.getElementById("welcome").style.display = "none";
  document.getElementById("message").style.display = "block";
  document.getElementById("message").classList.add("fade");

}

</script>

</body>
</html>
